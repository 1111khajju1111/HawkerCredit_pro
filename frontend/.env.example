# ---------------------------------------------------------------------------
# HawkerCredit frontend environment variables
# Copy to `.env.local` for local dev. On Vercel, set these under
# Project Settings -> Environment Variables for Production AND Preview.
# ---------------------------------------------------------------------------

# Full base URL (including /api/v1) the BROWSER calls directly.
# Local dev:   http://localhost:8000/api/v1
# Production:  https://<your-render-service>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Base URL (NO /api/v1 suffix) used server-side by next.config.js's rewrite
# rule for /api/v1/*. Optional fallback path if NEXT_PUBLIC_API_URL isn't
# used somewhere; harmless to set to the same host either way.
# Local dev:   http://localhost:8000
# Production:  https://<your-render-service>.onrender.com
BACKEND_URL=http://localhost:8000
