# ---------------------------------------------------------------------------
# HawkerCredit backend environment variables
# Copy to `.env` for local dev. On Render, set these under
# Dashboard -> your service -> Environment (never commit a filled-in .env).
# ---------------------------------------------------------------------------

# REQUIRED in production. Generate with: openssl rand -hex 32
# If unset locally, a random per-process secret is generated (dev only —
# every restart invalidates existing tokens). Startup FAILS if unset and
# ENVIRONMENT=production, by design (see app/core/config.py).
JWT_SECRET=

# Marks this as a real deployment (enables the JWT_SECRET hard requirement
# above). Set to "production" on Render.
ENVIRONMENT=development

# One-time bootstrap secret used to create the very first ADMIN/LENDER
# account via POST /api/v1/auth/staff/register (header X-Bootstrap-Secret).
# Generate with: openssl rand -hex 32. Leave unset only for local dev.
STAFF_BOOTSTRAP_SECRET=

# Database connection string.
# Local dev default (no setup needed): sqlite:///./hawkercredit.db
# Render/production: use the Postgres "Internal Database URL" Render gives
# you, e.g. postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./hawkercredit.db

# Comma-separated list of allowed frontend origins for CORS.
# Include your Vercel production URL AND Vercel preview-deployment pattern
# if you use preview deploys, e.g.:
# https://hawkercredit.vercel.app,https://hawkercredit-git-main-yourteam.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Render sets this automatically; the Dockerfile CMD already reads it
# (defaults to 10000 if unset). No action needed on Render.
PORT=10000

# Demo/hackathon convenience: on startup, additively seeds ~100 synthetic
# vendors + 10 lenders + 1 admin if the tables are empty. Never wipes data.
# Set to "false" for a clean, non-demo production deployment.
DEMO_SEED_ON_STARTUP=true
